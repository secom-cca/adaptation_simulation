{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "StopGpuInstance",
      "Effect": "Allow",
      "Action": "ec2:StopInstances",
      "Resource": "arn:aws:ec2:*:*:instance/*",
      "Condition": {
        "StringEquals": { "aws:ResourceTag/Project": "adaptation-gpu" }
      }
    }
  ]
}
