{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadGpuState",
      "Effect": "Allow",
      "Action": "ec2:DescribeInstances",
      "Resource": "*"
    },
    {
      "Sid": "StartAdaptationGpu",
      "Effect": "Allow",
      "Action": "ec2:StartInstances",
      "Resource": "arn:aws:ec2:REGION:ACCOUNT_ID:instance/GPU_INSTANCE_ID"
    },
    {
      "Sid": "ManageGpuAutoStopSchedule",
      "Effect": "Allow",
      "Action": [
        "scheduler:CreateSchedule",
        "scheduler:GetSchedule",
        "scheduler:UpdateSchedule"
      ],
      "Resource": "arn:aws:scheduler:REGION:ACCOUNT_ID:schedule/default/adaptation-gpu-autostop"
    },
    {
      "Sid": "PassGpuStopRoleToScheduler",
      "Effect": "Allow",
      "Action": "iam:PassRole",
      "Resource": "arn:aws:iam::ACCOUNT_ID:role/adaptation-scheduler-ec2-stop",
      "Condition": {
        "StringEquals": {
          "iam:PassedToService": "scheduler.amazonaws.com"
        }
      }
    }
  ]
}
