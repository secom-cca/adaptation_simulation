# Copy to deploy/.env.aws and fill in (do NOT commit deploy/.env.aws)

AWS_REGION=ap-northeast-1

# GPU EC2 for Ollama
GPU_INSTANCE_ID=i-xxxxxxxxxxxxxxxxx

# EventBridge Scheduler role that can call ec2:StopInstances
# Example: arn:aws:iam::123456789012:role/adaptation-scheduler-ec2-stop
SCHEDULER_ROLE_ARN=

# Optional: schedule name used for auto-stop (default below)
# AUTO_STOP_SCHEDULE_NAME=adaptation-gpu-autostop

# Default hours until automatic stop after start-gpu-ollama.sh
AUTO_STOP_AFTER_HOURS=3

# Web image / ECS (used by push-web-image.sh)
AWS_ACCOUNT_ID=
ECR_REPOSITORY=adaptation-web
ECS_CLUSTER=adaptation
ECS_SERVICE=adaptation-web
IMAGE_TAG=latest

# Public URL (for your notes / curl examples)
# PUBLIC_BASE_URL=https://your-alb.example.com
